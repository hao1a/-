{
  "name": "student-manager",
  "version": "1.0.0",
  "description": "学生信息管理系统",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/core.test.js",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.local.studentmanager",
    "productName": "学生管理系统",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "学生管理系统"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "lucide": "^1.28.0",
    "xlsx": "^0.18.5"
  }
}
